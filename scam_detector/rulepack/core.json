  },
  {
   "id": "weekly_stipend",
   "status": "active",
   "severity": "warning",
   "weight": 18,
   "title": "A flat weekly amount for part-time work",
   "why": "Scam offers quote a round weekly sum ('$350 weekly', '$550 per week') for a few hours of vague remote work. Real part-time jobs quote an hourly rate. Writing 'every 7 days' instead of 'weekly' doesn't change it.",
   "phrases": [],
   "patterns": [
    "\\$\\s?\\d{3}(?:[.,]\\d{2})?\\s*(?:\\(?usd\\)?\\s*)?(?:weekly|per\\s+week|a\\s+week|each\\s+week|every\\s+week|every\\s+(?:7|seven)\\s+days|/\\s?(?:week|wk))\\b",
    "\\bweekly\\s+(?:pay|salary|remuneration|allowance|wages?|compensation|stipend)\\s*(?:of|:|is)?\\s*(?:up\\s+to\\s+)?\\$\\s?\\d{3}\\b",
    "\\b(?:earn|make|get\\s+paid)\\s+(?:up\\s+to\\s+)?\\$\\s?\\d{3}(?:\\.\\d\\d)?\\s*(?:\\(?usd\\)?\\s*)?(?:weekly|every\\s+(?:7|seven)\\s+days)\\b"
   ],
   "guards": [],
   "min_matches": 1,
   "bonus": 3,
   "added": "2026-09-30",
   "source": "field test Sept 2026 (Evan's labeled reasons)"
  },
  {
   "id": "personal_channel",
   "status": "active",
   "severity": "warning",
   "weight": 18,
   "title": "Moves hiring to a personal phone, email or social account",
   "why": "You're told to text a number, reply from your personal or 'alternative' email instead of your school address, or message someone on Instagram. That keeps the conversation away from your school's spam filters and anyone who could warn you.",
   "phrases": [],
