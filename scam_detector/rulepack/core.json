   "source": "original"
  },
  {
   "id": "preselected_offer",
   "status": "active",
   "severity": "warning",
   "weight": 20,
   "title": "A job offer you never applied for",
   "why": "The message says you've already been 'chosen' or 'selected' or that an offer was 'approved for you', or that they found your CV or email somewhere. Real employers don't hand out offers to people who never applied.",
