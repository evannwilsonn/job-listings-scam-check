    "\\byou\\s+are\\s+invited\\s+to\\s+participate\\s+in\\s+a\\s+part[- ]time\\s+job\\b",
    "\\byour\\s+resume\\s+is\\s+very\\s+suitable\\b"
   ],
   "guards": [],
   "min_matches": 1,
